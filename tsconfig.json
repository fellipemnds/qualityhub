{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "prisma7.config.ts"],
    "exclude": ["node_modules", "dist"]
}