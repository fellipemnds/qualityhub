# Conexão com o PostgreSQL local: os mesmos usuário, senha e banco do docker-compose.yml (só desenvolvimento)
DATABASE_URL="postgresql://qualityhub:qualityhub_dev@localhost:5432/qualityhub?schema=public"

# Chave de assinatura dos tokens de login: no mínimo 32 caracteres, ou o servidor não sobe (app.ts).
# Gere a sua com: openssl rand -base64 32
JWT_SECRET="troque-por-uma-chave-gerada"

# Endereço do sistema, usado no link de convite do npm run criar-admin. Opcional: sem ele, o link sai só com o caminho
URL_DO_SISTEMA="http://localhost:5173"
