### ===========================================================
### PARE AQUI. Defina o aprovador via psql antes de continuar:
###
###   INSERT INTO "Atribuicao" ("registroId", "usuarioId", funcao, "atribuidoPorId", "atribuidoEm")
###   VALUES ('COLE_O_ID_DE_ncRegras_AQUI', (SELECT id FROM "Usuario" WHERE email = 'aprovador@teste.com'), 'APROVADOR', (SELECT id FROM "Usuario" WHERE email = 'admin@teste.com'), now());
