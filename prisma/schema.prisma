// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  criadoEm DateTime @default(now())

  usuarios         Usuario[]
  naoConformidades NaoConformidade[]
}

enum OrigemNC {
  AUDITORIA_INTERNA
  AUDITORIA_EXTERNA
  OPERACAO
  RECLAMACAO_CLIENTE
}

enum TipoRegistro {
  NAO_CONFORMIDADE
  CONCESSAO
}

enum EstadoNC {
  ABERTA
  ANALISE
  IMPROCEDENTE
  CONTENCAO
  ACAO_CORRETIVA
  VERIFICACAO
  ENCERRADA
}

enum ClassificacaoNC {
  MAJOR
  MINOR
}

model NaoConformidade {
  id     Int    @id @default(autoincrement())
  numero String @unique

  titulo           String
  descricao        String
  requisitoViolado String
  classificacao    ClassificacaoNC?
  analiseCausa     String?

  tipo   TipoRegistro @default(NAO_CONFORMIDADE)
  origem OrigemNC
  estado EstadoNC     @default(ABERTA)

  cliente String?

  dataOcorrencia DateTime
  dataRegistro   DateTime @default(now())

  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  atualizadoEm  DateTime       @updatedAt
  reaberturas   Int            @default(0)
  contencoes    Contencao[]
  investigacoes Investigacao[]
  anexos        Anexo[]
}

model Contencao {
  id            Int       @id @default(autoincrement())
  responsavelId Int
  responsavel   Usuario   @relation("ContencaoResponsavel", fields: [responsavelId], references: [id])
  descricao     String
  prazo         DateTime
  concluidaEm   DateTime?

  naoConformidadeId Int
  naoConformidade   NaoConformidade @relation(fields: [naoConformidadeId], references: [id])

  anexos Anexo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique

  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contencoesResponsavel    Contencao[]    @relation("ContencaoResponsavel")
  investigacoesResponsavel Investigacao[] @relation("InvestigacaoResponsavel")
  anexosEnviados           Anexo[]        @relation("AnexoEnviadoPor")
  acoesResponsavel         Acao[]         @relation("AcaoResponsavel")
  verificacoesResponsavel  Verificacao[]  @relation("VerificacaoResponsavel")
}

model Investigacao {
  id                Int             @id @default(autoincrement())
  naoConformidadeId Int
  naoConformidade   NaoConformidade @relation(fields: [naoConformidadeId], references: [id])
  responsavelId     Int
  responsavel       Usuario         @relation("InvestigacaoResponsavel", fields: [responsavelId], references: [id])

  causaRaiz   String
  metodologia String?
  abrangencia String?

  anexos Anexo[]
  acoes  Acao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Anexo {
  id           Int    @id @default(autoincrement())
  nomeArquivo  String
  caminho      String
  tipoMime     String
  tamanhoBytes Int

  naoConformidadeId Int?
  naoConformidade   NaoConformidade? @relation(fields: [naoConformidadeId], references: [id])

  contencaoId Int?
  contencao   Contencao? @relation(fields: [contencaoId], references: [id])

  investigacaoId Int?
  investigacao   Investigacao? @relation(fields: [investigacaoId], references: [id])

  acaoId Int?
  acao   Acao? @relation(fields: [acaoId], references: [id])

  verificacaoId Int?
  verificacao   Verificacao? @relation(fields: [verificacaoId], references: [id])

  criadoEm DateTime @default(now())

  enviadoPorId Int
  enviadoPor   Usuario @relation("AnexoEnviadoPor", fields: [enviadoPorId], references: [id])
}

model Acao {
  id             Int       @id @default(autoincrement())
  descricao      String
  efeitoEsperado String
  prazo          DateTime
  concluidaEm    DateTime?

  investigacaoId Int
  investigacao   Investigacao @relation(fields: [investigacaoId], references: [id])

  responsavelId Int
  responsavel   Usuario @relation("AcaoResponsavel", fields: [responsavelId], references: [id])

  anexos       Anexo[]
  verificacoes Verificacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum ResultadoVerificacao {
  PENDENTE
  EFICAZ
  PARCIALMENTE_EFICAZ
  NAO_EFICAZ
}

model Verificacao {
  id           Int                  @id @default(autoincrement())
  resultado    ResultadoVerificacao @default(PENDENTE)
  conclusao    String?
  dataAlvo     DateTime
  verificadoEm DateTime?

  acaoId Int
  acao   Acao @relation(fields: [acaoId], references: [id])

  responsavelId Int
  responsavel   Usuario @relation("VerificacaoResponsavel", fields: [responsavelId], references: [id])

  anexos Anexo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
