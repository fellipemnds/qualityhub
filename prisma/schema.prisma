// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  criadoEm DateTime @default(now())

  usuarios         Usuario[]
  naoConformidades NaoConformidade[]
}

enum OrigemNC {
  AUDITORIA_INTERNA
  AUDITORIA_EXTERNA
  OPERACAO
  RECLAMACAO_CLIENTE
}

enum TipoRegistro {
  NAO_CONFORMIDADE
  CONCESSAO
}

enum EstadoNC {
  ABERTA
  ANALISE
  IMPROCEDENTE
  CONTENCAO
  ACAO_CORRETIVA
  VERIFICACAO
  ENCERRADA
}

model NaoConformidade {
  id     Int    @id @default(autoincrement())
  numero String @unique

  titulo           String
  descricao        String
  requisitoViolado String

  tipo   TipoRegistro @default(NAO_CONFORMIDADE)
  origem OrigemNC
  estado EstadoNC     @default(ABERTA)

  cliente String?

  dataOcorrencia DateTime
  dataRegistro   DateTime @default(now())

  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  atualizadoEm DateTime    @updatedAt
  reaberturas  Int         @default(0)
  contencoes   Contencao[]
}

model Contencao {
  id            Int       @id @default(autoincrement())
  responsavelId Int
  responsavel   Usuario   @relation("ContencaoResponsavel", fields: [responsavelId], references: [id])
  descricao     String
  prazo         DateTime
  concluidaEm   DateTime?

  naoConformidadeId Int
  naoConformidade   NaoConformidade @relation(fields: [naoConformidadeId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique

  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contencoesResponsavel Contencao[] @relation("ContencaoResponsavel")
}
