// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------

// Registro
enum TipoRegistro {
  NAO_CONFORMIDADE
  CLASSIFICACAO
  CONTENCAO
  INVESTIGACAO
  ACAO_CORRETIVA
  VERIFICACAO
}

enum EstadoRegistro {
  RASCUNHO
  ABERTO
  EM_APROVACAO
  FECHADO
  CANCELADO
}

model Registro {
  id          String         @id @default(uuid(7))
  tipo        TipoRegistro
  codigo      String?        @unique
  estado      EstadoRegistro @default(RASCUNHO)
  portaoAtual Int            @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPorId String
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  naoConformidade NaoConformidade?
  contencao       Contencao?
  classificacao   Classificacao?
  investigacao    Investigacao?
  acaoCorretiva   AcaoCorretiva?
  verificacao     Verificacao?
  atribuicoes     Atribuicao[]
  aprovacoes      Aprovacao[]
  reaberturas     Reabertura[]
  cancelamentos   Cancelamento[]
}

// Não Conformidade
enum OrigemNC {
  AUDITORIA_INTERNA
  AUDITORIA_EXTERNA
  OPERACAO
  RECLAMACAO_CLIENTE
}

enum ClassificacaoNC {
  MAIOR
  MENOR
}

model NaoConformidade {
  id               String  @id
  titulo           String?
  descricao        String?
  requisitoViolado String?
  processoAfetado  String?

  setorId     Int?
  setor       Setor?    @relation(fields: [setorId], references: [id])
  detectadoEm DateTime?
  origem      OrigemNC?
  cliente     String?

  riscosRevisados String?
  mudancasSGQ     String?

  registro        Registro        @relation(fields: [id], references: [id], onDelete: Cascade)
  contencoes      Contencao[]
  classificacoes  Classificacao[]
  investigacoes   Investigacao[]
  acoesCorretivas AcaoCorretiva[]
}

// Classificação

model Classificacao {
  id                String           @id
  registro          Registro         @relation(fields: [id], references: [id], onDelete: Cascade)
  naoConformidade   NaoConformidade  @relation(fields: [naoConformidadeId], references: [id], onDelete: Cascade)
  naoConformidadeId String
  valor             ClassificacaoNC?
  justificativa     String?
}

// Setor
model Setor {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  criadoEm DateTime @default(now())

  usuarios         Usuario[]
  naoConformidades NaoConformidade[]
}

// Usuário
enum Papel {
  VISUALIZADOR
  EDITOR
  APROVADOR
  GERENTE
  ADMIN
}

model UsuarioPapel {
  usuario        Usuario  @relation("papeisRecebidos", fields: [usuarioId], references: [id])
  usuarioId      String
  papel          Papel
  concedidoPorId String
  concedidoPor   Usuario  @relation("papeisConcedidos", fields: [concedidoPorId], references: [id])
  concedidoEm    DateTime @default(now())

  @@id([usuarioId, papel])
}

model Usuario {
  id               String         @id @default(uuid(7))
  nome             String
  email            String         @unique
  senhaHash        String?
  papeisRecebidos  UsuarioPapel[] @relation("papeisRecebidos")
  papeisConcedidos UsuarioPapel[] @relation("papeisConcedidos")

  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  registros Registro[]

  atribuicoesRecebidas  Atribuicao[]   @relation("atribuicoesRecebidas")
  atribuicoesConcedidas Atribuicao[]   @relation("atribuicoesConcedidas")
  tokensAcesso          TokenAcesso[]
  registrosAuditoria    Auditoria[]
  aprovacoes            Aprovacao[]
  reaberturas           Reabertura[]
  cancelamentos         Cancelamento[]
}

enum TipoTokenAcesso {
  CONVITE
  RECUPERACAO_SENHA
}

model TokenAcesso {
  id        String          @id @default(uuid(7))
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  tipo      TipoTokenAcesso
  tokenHash String          @unique
  expiraEm  DateTime
  usadoEm   DateTime?
}

// Contador para os códigos
model ContadorSequencia {
  prefixo      String
  ano          Int
  ultimoNumero Int    @default(0)

  @@id([prefixo, ano])
}

// Atribuição para os itens
enum FuncaoAtribuicao {
  COLABORADOR
  APROVADOR
}

model Atribuicao {
  registroId String
  registro   Registro         @relation(fields: [registroId], references: [id], onDelete: Cascade)
  usuario    Usuario          @relation("atribuicoesRecebidas", fields: [usuarioId], references: [id])
  usuarioId  String
  funcao     FuncaoAtribuicao

  atribuidoPor   Usuario  @relation("atribuicoesConcedidas", fields: [atribuidoPorId], references: [id])
  atribuidoPorId String
  atribuidoEm    DateTime @default(now())

  @@id([registroId, usuarioId, funcao])
  @@unique([registroId], where: { funcao: "APROVADOR" }, map: "atribuicao_um_aprovador")
}

// Auditoria

model Auditoria {
  id         String @id @default(uuid(7))
  entidade   String
  entidadeId String
  acao       String
  antes      Json?
  depois     Json?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  registradoEm DateTime @default(now())

  @@index([entidade, entidadeId, registradoEm])
}

// Aprovacão

enum PortaoAprovacao {
  FECHAMENTO
  UNICA
  PLANO
  EXECUCAO
}

enum Decisao {
  APROVADO
  REPROVADO
}

model Aprovacao {
  id         String          @id @default(uuid(7))
  registroId String
  registro   Registro        @relation(fields: [registroId], references: [id])
  portao     PortaoAprovacao

  decisao       Decisao
  motivo        String?
  aprovadorId   String
  aprovador     Usuario @relation(fields: [aprovadorId], references: [id])
  autoAprovacao Boolean

  decididoEm DateTime @default(now())
}

// Reabertura 

model Reabertura {
  id         String   @id @default(uuid(7))
  registro   Registro @relation(fields: [registroId], references: [id])
  registroId String

  reabertoPor   Usuario @relation(fields: [reabertoPorId], references: [id])
  reabertoPorId String
  motivo        String

  reabertoEm DateTime @default(now())
}

// Cancelamento
model Cancelamento {
  id         String   @id @default(uuid(7))
  registro   Registro @relation(fields: [registroId], references: [id])
  registroId String

  canceladoPor   Usuario @relation(fields: [canceladoPorId], references: [id])
  canceladoPorId String
  motivo         String

  canceladoEm DateTime @default(now())
}

// Contenção

enum Disposicao {
  ACEITO
  CORRIGIDO
  ANULADO
  EM_ANALISE
}

model Contencao {
  id                String          @id
  registro          Registro        @relation(fields: [id], references: [id], onDelete: Cascade)
  naoConformidade   NaoConformidade @relation(fields: [naoConformidadeId], references: [id], onDelete: Cascade)
  naoConformidadeId String
  descricao         String?
  executadaEm       DateTime?
  disposicao        Disposicao?
}

// Investigacao

enum MetodoInvestigacao {
  A3_SPS
}

model Investigacao {
  id                String              @id
  registro          Registro            @relation(fields: [id], references: [id], onDelete: Cascade)
  naoConformidade   NaoConformidade     @relation(fields: [naoConformidadeId], references: [id], onDelete: Cascade)
  naoConformidadeId String
  realProblema      String?
  metodo            MetodoInvestigacao?
  conteudo          Json?
  causaDireta       String?
  causaRaiz         String?
  hipoteses         Hipotese[]
  acoesCorretivas   AcaoCorretiva[]
}

enum ClassificacaoHipotese {
  CAUSA_DIRETA
  FATOR_CONTRIBUINTE
  SEM_RELACAO
}

model Hipotese {
  id             String                 @id @default(uuid(7))
  investigacaoId String
  investigacao   Investigacao           @relation(fields: [investigacaoId], references: [id], onDelete: Cascade)
  descricao      String?
  numeroIshikawa Int?
  classificacao  ClassificacaoHipotese?
}

// Acão Corretiva
model AcaoCorretiva {
  id                String          @id
  registro          Registro        @relation(fields: [id], references: [id], onDelete: Cascade)
  naoConformidade   NaoConformidade @relation(fields: [naoConformidadeId], references: [id], onDelete: Cascade)
  naoConformidadeId String
  investigacaoId    String?
  investigacao      Investigacao?   @relation(fields: [investigacaoId], references: [id])

  descricao             String?
  prazo                 DateTime?
  executadoEm           DateTime?
  evidencia             String?
  instrucoesVerificacao String?

  verificacoes Verificacao[]
}

// Verificação

enum ResultadoVerificacao {
  EFICAZ
  PARCIALMENTE_EFICAZ
  NAO_EFICAZ
}

model Verificacao {
  id              String        @id
  registro        Registro      @relation(fields: [id], references: [id], onDelete: Cascade)
  acaoCorretivaId String
  acaoCorretiva   AcaoCorretiva @relation(fields: [acaoCorretivaId], references: [id])

  instrucoesVerificacao String?
  prazo                 DateTime?
  resultado             ResultadoVerificacao?
  conclusao             String?
  verificadoEm          DateTime?
}

